rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 학급 내부용 소규모 앱: 주소를 아는 사람은 읽기/쓰기 가능.
    // 보안을 강화하려면 Firebase Authentication 을 붙이고
    // allow write: if request.auth != null; 형태로 바꾸세요.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
